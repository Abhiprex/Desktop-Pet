#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Desktop Pet Griffin - macOS Application Bundle Launcher
# Fully self-contained: runs from folder or when installed to /Applications
# -----------------------------------------------------------------------------
set -e

# Determine where the app is located
BUNDLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PARENT_DIR="$(cd "$BUNDLE_DIR/../.." && pwd)"

if [ -f "$BUNDLE_DIR/Resources/run_pet.py" ]; then
    APP_ROOT="$BUNDLE_DIR/Resources"
elif [ -f "$PARENT_DIR/run_pet.py" ]; then
    APP_ROOT="$PARENT_DIR"
else
    APP_ROOT="$BUNDLE_DIR"
fi

cd "$APP_ROOT"

# Locate Python 3 on macOS (Apple Silicon M1 or Intel)
PYTHON_BIN=""
if [ -f "$APP_ROOT/venv/bin/python3" ]; then
    PYTHON_BIN="$APP_ROOT/venv/bin/python3"
elif [ -f "$PARENT_DIR/venv/bin/python3" ]; then
    PYTHON_BIN="$PARENT_DIR/venv/bin/python3"
elif [ -x "/opt/homebrew/bin/python3" ]; then
    PYTHON_BIN="/opt/homebrew/bin/python3"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN="$(command -v python3)"
elif [ -x "/usr/local/bin/python3" ]; then
    PYTHON_BIN="/usr/local/bin/python3"
fi

if [ -z "$PYTHON_BIN" ]; then
    osascript -e 'display alert "Python 3 Required" message "Please install Python 3 on your Mac via Homebrew (brew install python) or python.org to run Desktop Pet."'
    exit 1
fi

# Ensure required libraries (PyQt6 and Pillow) are installed
if ! "$PYTHON_BIN" -c "import PyQt6, PIL" &>/dev/null; then
    "$PYTHON_BIN" -m pip install -r "$APP_ROOT/requirements.txt" || "$PYTHON_BIN" -m pip install PyQt6 Pillow
fi

exec "$PYTHON_BIN" "$APP_ROOT/run_pet.py" "$@"
